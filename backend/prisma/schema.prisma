generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum AdminRole {
  ADMIN
  OWNER
  DEVELOPER
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.VarChar(255)
  darkMode     Boolean   @default(false)
  role         AdminRole @default(ADMIN)
  name         String?   @db.VarChar(80)
  sessionVersion Int     @default(0)
  failedLoginCount   Int       @default(0)
  failedLoginResetAt DateTime?
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reportedTickets Ticket[] @relation("TicketReporter")
  assignedTickets Ticket[] @relation("TicketAssignee")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([branchId])
}

model RevokedSession {
  id        String   @id @db.VarChar(64)
  expiresAt DateTime

  @@index([expiresAt])
}

model Branch {
  id           String        @id @default(cuid())
  name         String        @unique @db.VarChar(120)
  admins       Admin[]
  doctors      Doctor[]
  tickets      Ticket[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Doctor {
  id           String        @id @default(cuid())
  branchId     String
  name         String        @db.VarChar(80)
  isDefault    Boolean       @default(false)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([branchId, name])
  @@index([branchId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
}

model Appointment {
  id            String   @id @default(cuid())
  patientName   String   @db.VarChar(120)
  treatment     String   @default("Belum dicatat") @db.VarChar(160)
  scheduledDate DateTime @db.Date
  startTime     String   @db.VarChar(5)
  endTime       String   @db.VarChar(5)
  phone         String?  @db.VarChar(20)
  branchId      String
  doctorId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  status        AppointmentStatus @default(SCHEDULED)
  completedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([deletedAt])
  @@index([status, scheduledDate])
  @@index([branchId, doctorId, scheduledDate, startTime])
  @@index([branchId, scheduledDate, startTime])
  @@index([patientName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([treatment(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Ticket {
  id               String       @id @default(cuid())
  number           Int          @unique @default(autoincrement())
  title            String       @db.VarChar(120)
  description      String       @db.VarChar(2000)
  imageUrls        String[]     @default([])
  status           TicketStatus @default(OPEN)
  reporterId       String
  branchId         String
  assigneeId       String?
  resolutionNote   String?      @db.VarChar(1000)
  resolvedAt       DateTime?
  seenByReporterAt DateTime?
  reporter         Admin        @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee         Admin?       @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  branch           Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([reporterId, status])
  @@index([status, createdAt])
}
